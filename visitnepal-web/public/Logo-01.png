<div class="mw-heading mw-heading2"><h2 id="Research">Research</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=CMR_Institute_of_Technology&amp;action=edit&amp;section=5" title="Edit section: Research"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
